#pragma no_eval

int sum_to(int n) {
    int total = 0
    int i = 0
    while (i <= n) {
        total = total + i
        i = i + 1
    }
    return total
}

void main() {
    int k = 0
    while (k < 10) {
        println(sum_to(k))
        k = k + 1
    }
}
