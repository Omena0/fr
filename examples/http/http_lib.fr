// A small HTTP/1.1 server/client library.
//
// The library deliberately keeps headers as a list of "Name: value" strings
// rather than a dict inside a struct, so it works identically on the native,
// C and Python runtimes (including native reference-counted cleanup).

struct HttpRequest {
    str method
    str path
    str version
    str body
    list headers
}

struct HttpResponse {
    int status
    str body
    list headers
}

str http_reason(int status) {
    if (status == 200) { return "OK" }
    if (status == 201) { return "Created" }
    if (status == 204) { return "No Content" }
    if (status == 301) { return "Moved Permanently" }
    if (status == 302) { return "Found" }
    if (status == 304) { return "Not Modified" }
    if (status == 400) { return "Bad Request" }
    if (status == 401) { return "Unauthorized" }
    if (status == 403) { return "Forbidden" }
    if (status == 404) { return "Not Found" }
    if (status == 405) { return "Method Not Allowed" }
    if (status == 500) { return "Internal Server Error" }
    return "Unknown"
}

str http_get_header(list headers, str name) {
    str wanted = lower(strip(name))
    int i = 0
    while (i < len(headers)) {
        str line = headers[i]
        list parts = line.split(":")
        if (len(parts) >= 2) {
            str key = lower(strip(parts[0]))
            if (key == wanted) {
                str value = strip(parts[1])
                int j = 2
                while (j < len(parts)) {
                    value = value + ":" + parts[j]
                    j = j + 1
                }
                return strip(value)
            }
        }
        i = i + 1
    }
    return ""
}

list http_parse_header_lines(list lines) {
    list headers = []
    int i = 1
    while (i < len(lines)) {
        str line = strip(lines[i])
        if (line == "") { break }
        if (contains(line, ":")) {
            headers.append(line)
        }
        i = i + 1
    }
    return headers
}

HttpRequest http_parse_request(str raw) {
    list parts = raw.split("\r\n\r\n")
    str head = parts[0]
    str body = ""
    if (len(parts) > 1) {
        body = parts[1]
        int i = 2
        while (i < len(parts)) {
            body = body + "\r\n\r\n" + parts[i]
            i = i + 1
        }
    }

    list lines = head.split("\r\n")
    str method = "GET"
    str path = "/"
    str version = "HTTP/1.1"
    if (len(lines) > 0) {
        list start = lines[0].split(" ")
        if (len(start) > 0) { method = start[0] }
        if (len(start) > 1) { path = start[1] }
        if (len(start) > 2) { version = start[2] }
    }

    return HttpRequest(method, path, version, body, http_parse_header_lines(lines))
}

HttpResponse http_parse_response(str raw) {
    list parts = raw.split("\r\n\r\n")
    str head = parts[0]
    str body = ""
    if (len(parts) > 1) {
        body = parts[1]
        int i = 2
        while (i < len(parts)) {
            body = body + "\r\n\r\n" + parts[i]
            i = i + 1
        }
    }

    list lines = head.split("\r\n")
    int status = 0
    if (len(lines) > 0) {
        list start = lines[0].split(" ")
        if (len(start) > 1) { status = int(start[1]) }
    }

    return HttpResponse(status, body, http_parse_header_lines(lines))
}

str http_serialize_response(HttpResponse response) {
    str out = "HTTP/1.1 " + str(response.status) + " " + http_reason(response.status) + "\r\n"
    int i = 0
    bool has_length = false
    while (i < len(response.headers)) {
        str line = response.headers[i]
        list parts = line.split(":")
        if (len(parts) > 0) {
            if (lower(strip(parts[0])) == "content-length") { has_length = true }
        }
        out = out + line + "\r\n"
        i = i + 1
    }
    if (not has_length) {
        out = out + "Content-Length: " + str(len(response.body)) + "\r\n"
    }
    out = out + "Connection: close\r\n\r\n" + response.body
    return out
}

str http_serialize_request(str host, str method, str path, str body) {
    str out = method + " " + path + " HTTP/1.1\r\n"
    out = out + "Host: " + host + "\r\n"
    out = out + "User-Agent: fr-http/1.0\r\n"
    out = out + "Content-Length: " + str(len(body)) + "\r\n"
    out = out + "Connection: close\r\n\r\n" + body
    return out
}

void http_send_response(int sock, HttpResponse response) {
    sendall(sock, http_serialize_response(response).encode())
}

void http_send_request(int sock, str host, str method, str path, str body) {
    sendall(sock, http_serialize_request(host, method, path, body).encode())
}

str http_read_all(int sock) {
    str raw = ""
    while (true) {
        bytes chunk = sock.recv(4096)
        if (len(chunk) == 0) { break }
        raw = raw + chunk.decode()
    }
    return raw
}

str http_read_headers(int sock) {
    str raw = ""
    while (not contains(raw, "\r\n\r\n")) {
        bytes chunk = sock.recv(4096)
        if (len(chunk) == 0) { break }
        raw = raw + chunk.decode()
    }
    return raw
}

HttpRequest http_read_request(int sock) {
    str raw = http_read_headers(sock)
    HttpRequest request = http_parse_request(raw)

    str content_length = http_get_header(request.headers, "Content-Length")
    if (content_length != "") {
        int wanted = int(content_length)
        while (len(request.body) < wanted) {
            bytes chunk = sock.recv(4096)
            if (len(chunk) == 0) { break }
            request.body = request.body + chunk.decode()
        }
    }
    return request
}

HttpResponse http_read_response(int sock) {
    return http_parse_response(http_read_all(sock))
}

HttpResponse http_get(str host, int port, str path) {
    int sock = socket("inet", "stream")
    connect(sock, host, port)
    http_send_request(sock, host, "GET", path, "")
    HttpResponse response = http_read_response(sock)
    sclose(sock)
    return response
}

HttpResponse http_post(str host, int port, str path, str body) {
    int sock = socket("inet", "stream")
    connect(sock, host, port)
    http_send_request(sock, host, "POST", path, body)
    HttpResponse response = http_read_response(sock)
    sclose(sock)
    return response
}
